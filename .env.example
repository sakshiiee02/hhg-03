# ==============================================================================
# HH GOA TASK 3: ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BLOCKCHAIN (ETHEREUM SEPOLIA TESTNET)
# ------------------------------------------------------------------------------
# Set to 'false' to require live Sepolia, 'true' to force simulated mode,
# or 'auto' to use live Sepolia if credentials are present, falling back gracefully.
SIMULATED_BLOCKCHAIN=auto

# Sepolia RPC Endpoint (e.g., Alchemy, Infura, QuickNode, or public RPC)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 64-character hex private key funded with Sepolia testnet ETH
# Example: 0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SEPOLIA_PRIVATE_KEY=

# Deployed FaceVerificationRegistry contract address on Sepolia.
# If empty, run 'python -m src.blockchain.deploy' or let the pipeline deploy automatically.
SEPOLIA_CONTRACT_ADDRESS=

# ------------------------------------------------------------------------------
# 2. DISCOVERY & SEARCH ENGINES
# ------------------------------------------------------------------------------
# Search Engine Selection: 'auto', 'yandex', or 'serpapi'
# 'auto' runs Yandex Images and SerpApi (Google Lens + Bing Visual + Google Reverse) in parallel.
SEARCH_ENGINE=auto

# Optional SerpApi API key for multi-engine visual search (Google Lens, Bing, Google Reverse).
SERPAPI_API_KEY=

# Run Playwright browser in headless mode ('true' or 'false')
PLAYWRIGHT_HEADLESS=true

# ------------------------------------------------------------------------------
# 3. PIPELINE & PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# Concurrency limit for parallel candidate downloads (default: 8)
CONCURRENCY_LIMIT=8

# Enable adaptive early stopping once a high-confidence match is verified
EARLY_STOPPING=true

# Minimum cosine similarity threshold for an accepted match (default: 0.80)
SIMILARITY_THRESHOLD=0.80

# Minimum margin required over runner-up candidate (default: 0.10)
MARGIN_THRESHOLD=0.10
